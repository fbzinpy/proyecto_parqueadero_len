@{
    ViewData["Title"] = "Registrar salida";
}

@* DATOS DE EJEMPLO: la búsqueda y el cálculo del cobro vendrán de Parqueadero.Core. *@

<section class="seccion seccion--oscura">
    <div class="contenedor pila">
        <p class="antetitulo">Registrar salida · Carro · Cupo A-01</p>
        <h1 class="titulo-hero">ABC 123</h1>

        <form class="acciones" style="align-items: flex-end; gap: 24px; margin-top: 24px; max-width: 560px;">
            <div class="campo" style="flex: 1 1 240px;">
                <label class="etiqueta" for="placa">Buscar otra placa</label>
                <input id="placa" name="placa" type="text" value="ABC 123" />
            </div>
            <button type="button" class="boton-borde">Buscar</button>
        </form>
    </div>
</section>

<section class="seccion">
    <div class="contenedor pila" style="gap: 64px;">
        <div class="datos">
            <div class="dato">
                <span class="etiqueta">Hora de entrada</span>
                <span class="dato__valor">07:42</span>
            </div>
            <div class="dato">
                <span class="etiqueta">Hora de salida</span>
                <span class="dato__valor">10:15</span>
            </div>
            <div class="dato">
                <span class="etiqueta">Tiempo total</span>
                <span class="dato__valor">2 h 33 min</span>
            </div>
        </div>

        <div class="total">
            <div class="pila" style="gap: 16px;">
                <span class="etiqueta">Tarifa carro · $ [Tarifa] por hora · 3 horas cobradas</span>
                <span class="etiqueta" style="font-size: 16px;">Total a pagar</span>
                <span class="total__valor">$ [Total]</span>
            </div>
            <div class="acciones">
                <a class="enlace-flecha enlace-flecha--grande" asp-controller="Home" asp-action="Index">Cancelar</a>
                <button type="button" class="boton-amarillo">Cobrar y dar salida <span aria-hidden="true">→</span></button>
            </div>
        </div>
    </div>
</section>
