@{
    ViewData["Title"] = "Iniciar sesión";
    ViewData["SinMenu"] = true;
}

<div class="acceso">
    <div class="acceso__contenido">
        <div class="acceso__titulo">
            <p class="antetitulo">Universidad Santiago de Cali · Sistema de gestión</p>
            <h1 class="titulo-hero">Cada cupo<br />bajo control</h1>
        </div>

        <div class="acceso__tarjetas">
            <section class="acceso__tarjeta">
                <div class="pila" style="gap: 8px;">
                    <p class="etiqueta">Personal</p>
                    <h2 class="titulo-seccion">Iniciar sesión</h2>
                </div>

                @* Envía correo y clave a CuentaController.Login (POST), que usa ASP.NET Core Identity.
                   El tag helper del form agrega solo el token antifalsificación. *@
                <form class="formulario" asp-controller="Cuenta" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                    @if (ViewData["Error"] != null)
                    {
                        <p class="mensaje" role="alert">@ViewData["Error"]</p>
                    }
                    <div class="campo">
                        <label class="etiqueta" for="correo">Correo electrónico</label>
                        <input id="correo" name="correo" type="email" class="sin-mayusculas" placeholder="usuario@parqueadero.local" autocomplete="username" value="@ViewData["Correo"]" required />
                    </div>
                    <div class="campo">
                        <label class="etiqueta" for="clave">Contraseña</label>
                        <input id="clave" name="clave" type="password" autocomplete="current-password" required />
                    </div>
                    <label class="casilla">
                        <input type="checkbox" name="recordarme" value="true" /> Recordarme
                    </label>
                    <div>
                        <button type="submit" class="boton-amarillo">Ingresar <span aria-hidden="true">→</span></button>
                    </div>
                </form>

                <div class="roles">
                    <div class="pila" style="gap: 8px;">
                        <span class="etiqueta">Rol</span>
                        <span>Administrador</span>
                    </div>
                    <div class="pila" style="gap: 8px;">
                        <span class="etiqueta">Rol</span>
                        <span>Operador</span>
                    </div>
                </div>
            </section>

            <section class="acceso__tarjeta" id="login-disponibilidad" data-url-estado="@Url.Action("Estado", "Disponibilidad")">
                <div class="pila" style="gap: 8px;">
                    <p class="etiqueta">Conductores</p>
                    <h2 class="titulo-seccion">¿Hay cupo?</h2>
                </div>

                <p class="texto-destacado">¿Vienes a parquear? Mira si hay cupo antes de hacer la fila. No necesitas cuenta.</p>

                <div class="acceso__vivo" aria-live="polite">
                    <div class="acceso__vivo-dato">
                        <span class="acceso__vivo-numero" id="login-libres-carro">—</span>
                        <span class="etiqueta" id="login-texto-carro">cupos libres para carro</span>
                    </div>
                    <div class="acceso__vivo-dato">
                        <span class="acceso__vivo-numero" id="login-libres-moto">—</span>
                        <span class="etiqueta" id="login-texto-moto">cupos libres para moto</span>
                    </div>
                </div>

                <a class="boton-contorno" asp-controller="Disponibilidad" asp-action="Index">Ver disponibilidad <span aria-hidden="true">→</span></a>
            </section>
        </div>
    </div>
</div>
