@model AdminViewModel
@{
    ViewData["Title"] = "Administración";
}

<section class="seccion seccion--oscura">
    <div class="contenedor pila pila--amplia">
        <div class="pila">
            <p class="antetitulo">Resumen del día</p>
            <h1 class="titulo-grande">Administración</h1>
        </div>
        <div class="datos">
            <div class="dato">
                <span class="etiqueta">Ingresos del día</span>
                <span class="dato__valor dato__valor--medio">@Formato.Dinero(Model.IngresosDelDia)</span>
            </div>
            <div class="dato">
                <span class="etiqueta">Vehículos atendidos hoy</span>
                <span class="dato__valor dato__valor--medio">@Model.VehiculosAtendidos</span>
            </div>
            <div class="dato">
                <span class="etiqueta">Ocupación actual</span>
                <span class="dato__valor dato__valor--medio">@Model.CuposOcupados / @Model.TotalCupos</span>
            </div>
            <div class="dato">
                <span class="etiqueta">Operadores registrados</span>
                <span class="dato__valor dato__valor--medio">@Model.Operadores</span>
            </div>
        </div>
    </div>
</section>

<section class="seccion">
    <div class="contenedor pila pila--amplia">
        <div class="cabecera-seccion">
            <h2 class="titulo-seccion">Tarifas</h2>
            <a class="enlace-flecha" asp-action="EditarTarifas">Editar tarifas <span aria-hidden="true">→</span></a>
        </div>
        <div class="tarjetas">
            @foreach (var tarifa in Model.Tarifas)
            {
                <div class="tarjeta">
                    <span class="etiqueta">Vehículo</span>
                    <span class="dato__valor dato__valor--medio">@tarifa.Tipo</span>
                    <div class="tarjeta__fila tarjeta__fila--borde"><span>Por hora</span><span>@Formato.Dinero(tarifa.ValorHora)</span></div>
                    <div class="tarjeta__fila"><span>Cupos</span><span>@(tarifa.Tipo == TipoVehiculo.Carro ? Model.CuposCarro : Model.CuposMoto)</span></div>
                </div>
            }
        </div>
    </div>
</section>

<section class="seccion seccion--gris">
    <div class="contenedor pila pila--amplia">
        <div class="cabecera-seccion">
            <h2 class="titulo-seccion">Usuarios y roles</h2>
            <a class="boton-amarillo" asp-action="NuevoUsuario">Nuevo usuario <span aria-hidden="true">+</span></a>
        </div>
        <div class="tabla-scroll">
            <table class="tabla">
                <thead>
                    <tr>
                        <th>Correo</th>
                        <th>Rol</th>
                        <th><span class="solo-lector">Acción</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model.Usuarios)
                    {
                        <tr>
                            <td class="sin-mayusculas">@u.Correo</td>
                            <td><span class="insignia">@u.Rol</span></td>
                            <td class="derecha"><a class="enlace-flecha" asp-action="EditarUsuario" asp-route-id="@u.Id">Editar <span aria-hidden="true">→</span></a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
