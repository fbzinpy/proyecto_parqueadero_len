@* Fondo del plano (coordenadas 820 x 1000): andén, pasto, edificios, asfalto, carriles y árboles. *@
@{
    // (cx, cy, r) de cada árbol
    var arboles = new List<(int x, int y, int r)>
    {
        (40, 40, 26), (80, 100, 24), (770, 34, 26), (190, 745, 24), (245, 772, 28), (295, 745, 22), (190, 805, 20),
        (740, 950, 30), (790, 930, 24), (718, 756, 20)
    };
    for (int y = 120; y <= 680; y += 80)
    {
        arboles.Add((718, y, 20));
    }
}
