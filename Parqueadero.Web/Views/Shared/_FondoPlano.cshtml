@foreach (var a in arboles)
{
    <circle cx="@a.x" cy="@a.y" r="@a.r" fill="#344a30"/>
    <circle cx="@a.x" cy="@(a.y - 6)" r="@((a.r * 0.65).ToString(System.Globalization.CultureInfo.InvariantCulture))" fill="#41603a"/>
    <circle cx="@a.x" cy="@(a.y - 10)" r="@((a.r * 0.3).ToString(System.Globalization.CultureInfo.InvariantCulture))" fill="#557a4a"/>
}
