@model PanelViewModel
@using Parqueadero.Core.Servicios
@{
    ViewData["Title"] = "Panel";

    var libres = Model.TotalCupos - Model.CuposOcupados;
    var porcentaje = Model.TotalCupos == 0 ? 0 : Model.CuposOcupados * 100 / Model.TotalCupos;
    var ahora = DateTime.Now;

    // Posiciones del plano (de Core) y el cupo de la base de datos que corresponde a cada una.
    var posiciones = PlanoParqueadero.ObtenerPosiciones();
    var cuposPorCodigo = Model.Cupos.ToDictionary(c => c.Codigo);
    var totalCarros = Model.Cupos.Count(c => c.Tipo == TipoVehiculo.Carro);
    var totalMotos = Model.Cupos.Count(c => c.Tipo == TipoVehiculo.Moto);
    var libresCarro = Model.Cupos.Count(c => c.Tipo == TipoVehiculo.Carro && !Model.IdsOcupados.Contains(c.Id));
    var libresMoto = Model.Cupos.Count(c => c.Tipo == TipoVehiculo.Moto && !Model.IdsOcupados.Contains(c.Id));

    // Punto decimal fijo: en el SVG una coma como "22,5" no es válida.
    string N(double valor) => valor.ToString(System.Globalization.CultureInfo.InvariantCulture);
}

<section class="seccion seccion--oscura">
    <div class="contenedor pila">
        <p class="antetitulo">Turno operador</p>
        <h1 class="titulo-hero">@Model.CuposOcupados de @Model.TotalCupos<br />cupos ocupados</h1>

        <div class="pila" style="gap: 8px;">
            <div class="ocupacion" role="img" aria-label="@porcentaje % de ocupación">
                <div class="ocupacion__relleno" style="width: @porcentaje%;"></div>
            </div>
            <span class="etiqueta">@libres cupos libres</span>
        </div>

        <div class="acciones" style="margin-top: 16px;">
            <a class="boton-amarillo" asp-controller="Movimientos" asp-action="Entrada">Registrar entrada <span aria-hidden="true">→</span></a>
            <a class="enlace-flecha enlace-flecha--grande" asp-controller="Movimientos" asp-action="Salida">Registrar salida <span aria-hidden="true">→</span></a>
        </div>
    </div>
</section>

<section class="seccion" id="vehiculos">
    <div class="contenedor pila pila--amplia">
        <div class="cabecera-seccion">
            <h2 class="titulo-seccion">Vehículos dentro</h2>
            <a class="enlace-flecha" asp-controller="Movimientos" asp-action="Historial">Ver historial <span aria-hidden="true">→</span></a>
        </div>

        @* Filtros: cada botón es un enlace que recarga el panel con ?tipo=... (se conserva lo buscado) *@
        <div class="acciones" style="gap: 16px;">
            <a class="boton-borde @(Model.FiltroTipo == null ? "boton-borde--activo" : "")"
               asp-action="Index" asp-route-buscar="@Model.Buscar" asp-fragment="vehiculos">Todos</a>
            <a class="boton-borde @(Model.FiltroTipo == "Carro" ? "boton-borde--activo" : "")"
               asp-action="Index" asp-route-tipo="Carro" asp-route-buscar="@Model.Buscar" asp-fragment="vehiculos">Carro</a>
            <a class="boton-borde @(Model.FiltroTipo == "Moto" ? "boton-borde--activo" : "")"
               asp-action="Index" asp-route-tipo="Moto" asp-route-buscar="@Model.Buscar" asp-fragment="vehiculos">Moto</a>

            @* Buscador: formulario GET, la placa viaja en la URL (?buscar=ABC) *@
            <form class="buscador-form" method="get" asp-action="Index" asp-fragment="vehiculos">
                @if (Model.FiltroTipo != null)
                {
                    <input type="hidden" name="tipo" value="@Model.FiltroTipo" />
                }
                <label class="solo-lector" for="buscar">Buscar placa</label>
                <input id="buscar" name="buscar" type="search" class="buscador" placeholder="Buscar placa" value="@Model.Buscar" />
            </form>
        </div>

        @if (Model.VehiculosAdentro.Count == 0)
        {
            <p>@(Model.CuposOcupados == 0 ? "No hay vehículos adentro." : "Ningún vehículo coincide con el filtro.")</p>
        }
        else
        {
            <div class="tabla-scroll">
                <table class="tabla">
                    <thead>
                        <tr>
                            <th>Placa</th>
                            <th>Tipo</th>
                            <th>Cupo</th>
                            <th>Entrada</th>
                            <th>Tiempo</th>
                            <th><span class="solo-lector">Acción</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model.VehiculosAdentro)
                        {
                            <tr>
                                <td class="placa">@t.Placa</td>
                                <td>@t.Tipo</td>
                                <td>@t.Cupo?.Codigo</td>
                                <td>@t.HoraEntrada.ToString("HH:mm")</td>
                                <td>@Formato.Duracion(ahora - t.HoraEntrada)</td>
                                <td class="derecha">
                                    <a class="enlace-flecha" asp-controller="Movimientos" asp-action="Salida" asp-route-placa="@t.Placa">Dar salida <span aria-hidden="true">→</span></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>

<section class="seccion seccion--gris">
    <div class="contenedor pila pila--amplia">
        <div class="cabecera-seccion">
            <h2 class="titulo-seccion">Mapa de cupos</h2>
            <div class="leyenda">
                <span><span class="muestra"></span>Libre</span>
                <span><span class="muestra muestra--ocupado"></span>Ocupado</span>
                <span><span class="muestra muestra--seleccionado"></span>Seleccionado</span>
            </div>
        </div>

        @* El plano es un solo SVG: se escala con el ancho de la pantalla (tablet y celular). *@
        <div class="plano-contenedor">
            <svg class="plano" id="plano" viewBox="0 0 820 1000" role="group" aria-label="Plano del parqueadero">
                <partial name="_FondoPlano" />

                @foreach (var p in posiciones)
                {
                    var cupo = cuposPorCodigo[p.Codigo];
                    var ocupado = Model.IdsOcupados.Contains(cupo.Id);
                    var x = N(p.X);
                    var y = N(p.Y);
                    var giro = $"rotate({N(p.Rotacion)} {x} {y})";
                    var metros = PlanoParqueadero.MetrosAPorteria(p);

                    <g class="cupo-plano" data-id="@cupo.Id" data-codigo="@p.Codigo" data-tipo="@cupo.Tipo"
                       data-estado="@(ocupado ? "Ocupado" : "Libre")" data-zona="@p.Zona" data-metros="@metros">
                        <rect class="cupo-plano__borde" x="@N(p.X - p.Ancho / 2)" y="@N(p.Y - p.Alto / 2)"
                              width="@N(p.Ancho)" height="@N(p.Alto)" transform="@giro"
                              fill="transparent" stroke="#ffffff" stroke-width="2" />
                        @if (ocupado)
                        {
                            // Carro visto desde arriba: carrocería y vidrio, un poco más chicos que el cupo.
                            var vertical = p.Alto > p.Ancho;
                            var cw = p.Ancho - 6;
                            var ch = p.Alto - 6;
                            var vw = vertical ? cw - 4 : ch * 0.35;
                            var vh = vertical ? ch * 0.35 : ch - 4;
                            var vx = vertical ? p.X - vw / 2 : p.X + cw / 2 - vw - 3;
                            var vy = vertical ? p.Y - ch / 2 + 4 : p.Y - vh / 2;
                            <rect x="@N(p.X - cw / 2)" y="@N(p.Y - ch / 2)" width="@N(cw)" height="@N(ch)" rx="3"
                                  fill="#f2f2f2" transform="@giro" pointer-events="none" />
                            <rect x="@N(vx)" y="@N(vy)" width="@N(vw)" height="@N(vh)" rx="2"
                                  fill="#9aa3ad" transform="@giro" pointer-events="none" />
                        }
                    </g>
                }
            </svg>

            <aside class="plano-panel" id="plano-panel" data-url-entrada="@Url.Action("Entrada", "Movimientos")">
                <p class="etiqueta">Libres ahora</p>
                <p class="plano-panel__cifra">@libresCarro de @totalCarros carros</p>
                <p class="plano-panel__cifra">@libresMoto de @totalMotos motos</p>

                <div class="plano-panel__detalle">
                    <p id="plano-ayuda">Toca un cupo en el mapa para ver su código, en qué zona queda y qué tan lejos está de la portería.</p>
                    <div id="plano-seleccion" hidden>
                        <p class="plano-panel__codigo" id="sel-codigo"></p>
                        <p class="etiqueta" id="sel-estado"></p>
                        <p id="sel-zona"></p>
                        <p id="sel-metros"></p>
                        <a class="boton-amarillo" id="sel-entrada" href="#" hidden>Registrar entrada aquí <span aria-hidden="true">→</span></a>
                    </div>
                </div>
            </aside>
        </div>
    </div>
</section>
