@model PanelViewModel
@{
    ViewData["Title"] = "Panel";

    var libres = Model.TotalCupos - Model.CuposOcupados;
    var porcentaje = Model.TotalCupos == 0 ? 0 : Model.CuposOcupados * 100 / Model.TotalCupos;
    var ahora = DateTime.Now;
}

<section class="seccion seccion--oscura">
    <div class="contenedor pila">
        <p class="antetitulo">Turno operador</p>
        <h1 class="titulo-hero">@Model.CuposOcupados de @Model.TotalCupos<br />cupos ocupados</h1>

        <div class="pila" style="gap: 8px;">
            <div class="ocupacion" role="img" aria-label="@porcentaje % de ocupación">
                <div class="ocupacion__relleno" style="width: @porcentaje%;"></div>
            </div>
            <span class="etiqueta">@libres cupos libres</span>
        </div>

        <div class="acciones" style="margin-top: 16px;">
            <a class="boton-amarillo" asp-controller="Movimientos" asp-action="Entrada">Registrar entrada <span aria-hidden="true">→</span></a>
            <a class="enlace-flecha enlace-flecha--grande" asp-controller="Movimientos" asp-action="Salida">Registrar salida <span aria-hidden="true">→</span></a>
        </div>
    </div>
</section>

<section class="seccion" id="vehiculos">
    <div class="contenedor pila pila--amplia">
        <div class="cabecera-seccion">
            <h2 class="titulo-seccion">Vehículos dentro</h2>
            <a class="enlace-flecha" asp-controller="Movimientos" asp-action="Historial">Ver historial <span aria-hidden="true">→</span></a>
        </div>

        @* Filtros: cada botón es un enlace que recarga el panel con ?tipo=... (se conserva lo buscado) *@
        <div class="acciones" style="gap: 16px;">
            <a class="boton-borde @(Model.FiltroTipo == null ? "boton-borde--activo" : "")"
               asp-action="Index" asp-route-buscar="@Model.Buscar" asp-fragment="vehiculos">Todos</a>
            <a class="boton-borde @(Model.FiltroTipo == "Carro" ? "boton-borde--activo" : "")"
               asp-action="Index" asp-route-tipo="Carro" asp-route-buscar="@Model.Buscar" asp-fragment="vehiculos">Carro</a>
            <a class="boton-borde @(Model.FiltroTipo == "Moto" ? "boton-borde--activo" : "")"
               asp-action="Index" asp-route-tipo="Moto" asp-route-buscar="@Model.Buscar" asp-fragment="vehiculos">Moto</a>

            @* Buscador: formulario GET, la placa viaja en la URL (?buscar=ABC) *@
            <form class="buscador-form" method="get" asp-action="Index" asp-fragment="vehiculos">
                @if (Model.FiltroTipo != null)
                {
                    <input type="hidden" name="tipo" value="@Model.FiltroTipo" />
                }
                <label class="solo-lector" for="buscar">Buscar placa</label>
                <input id="buscar" name="buscar" type="search" class="buscador" placeholder="Buscar placa" value="@Model.Buscar" />
            </form>
        </div>

        @if (Model.VehiculosAdentro.Count == 0)
        {
            <p>@(Model.CuposOcupados == 0 ? "No hay vehículos adentro." : "Ningún vehículo coincide con el filtro.")</p>
        }
        else
        {
            <div class="tabla-scroll">
                <table class="tabla">
                    <thead>
                        <tr>
                            <th>Placa</th>
                            <th>Tipo</th>
                            <th>Cupo</th>
                            <th>Entrada</th>
                            <th>Tiempo</th>
                            <th><span class="solo-lector">Acción</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model.VehiculosAdentro)
                        {
                            <tr>
                                <td class="placa">@t.Placa</td>
                                <td>@t.Tipo</td>
                                <td>@t.Cupo?.Codigo</td>
                                <td>@t.HoraEntrada.ToString("HH:mm")</td>
                                <td>@Formato.Duracion(ahora - t.HoraEntrada)</td>
                                <td class="derecha">
                                    <a class="enlace-flecha" asp-controller="Movimientos" asp-action="Salida" asp-route-placa="@t.Placa">Dar salida <span aria-hidden="true">→</span></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>

<section class="seccion seccion--gris">
    <div class="contenedor pila pila--amplia">
        <div class="cabecera-seccion">
            <h2 class="titulo-seccion">Mapa de cupos</h2>
            <div class="leyenda">
                <span><span class="muestra muestra--ocupado"></span>Ocupado</span>
                <span><span class="muestra"></span>Libre</span>
            </div>
        </div>

        <ul class="cupos">
            @foreach (var cupo in Model.Cupos)
            {
                var estaOcupado = Model.IdsOcupados.Contains(cupo.Id);

                <li class="cupo @(estaOcupado ? "cupo--ocupado" : "")">
                    <small>@cupo.Tipo</small>
                    <span>@cupo.Codigo</span>
                    <span class="solo-lector">@(estaOcupado ? "Ocupado" : "Libre")</span>
                </li>
            }
        </ul>
    </div>
</section>
